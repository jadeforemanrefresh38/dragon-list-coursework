[Unit]
Description=Dragon list
After=network.target postgresql.service

[Service]
User=dragonlist
Group=dragonlist
WorkingDirectory=/opt/dragon-list
EnvironmentFile=/etc/dragon-list.env
ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /opt/dragon-list/dragon-list.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
